def final_grade(exam_score, coursework_score):
    if exam_score >= 90:
        grade = "A"
    elif exam_score >= 80:
        grade = "B"
    elif exam_score >= 70:
        grade = "C"
    elif exam_score >= 60:
        grade = "D"
    else:
        grade = "F"
    
    if coursework_score > 0:
        grade += "+"
    else:
        grade += "-"
        
    return grade

exam_score = float(input())
coursework_score = float(input())

result = final_grade(exam_score, coursework_score)

print(f"Final Grade: {result}")

